{
  "name": "rukny-io",
  "version": "1.0.0",
  "private": true,
  "overrides": {
    "@prisma/client": "^7.3.0",
    "prisma": "^7.3.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {

    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run start:dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspaces",
    "build:web": "npm run build --workspace=apps/web",
    "build:api": "npm run prisma:generate && npm run build --workspace=apps/api",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "prisma:generate": "node scripts/run-prisma-generate.js",
    "migrate": "prisma migrate deploy --schema=apps/api/prisma/schema.prisma",
    "build:railway": "npm install --include=dev && npm run prisma:generate && npm run build --workspace=apps/api"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "concurrently": "^8.2.0",
    "eslint": "^8.50.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.2.0"
  },
  "dependencies": {
    "@next/bundle-analyzer": "^16.1.5",
    "@prisma/client": "^7.3.0",
    "prisma": "^7.3.0",
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.3",
    "rxjs": "^7.8.2",
    "sonner": "^2.0.7",
    "react-is": "^19.2.4"
  }
}
