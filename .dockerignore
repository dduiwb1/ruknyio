# ============================================
# Docker ignore - جذر المشروع (سياق البناء لـ apps/api)
# لا تستبعد: package.json, package-lock.json, packages/, apps/api/
# ============================================

# Dependencies (يُثبتها Docker داخل الـ build)
node_modules/
.pnp
.pnp.js
.yarn/

# Build outputs
dist/
build/
.next/
out/
.turbo/
.vercel/
.output/
*.tsbuildinfo

# Git
.git/
.gitignore
.gitattributes

# Environment (لا نرفعها مع الصورة)
.env
.env.*
!.env.example

# IDE & OS
.vscode/
.idea/
.DS_Store
*.log

# Testing
coverage/
.nyc_output/
test-results/
playwright-report/
**/*.test.ts
**/*.spec.ts
**/test/
**/__tests__/
jest.config.*
.jest/

# Documentation (غير ضرورية للـ API في الصورة)
docs/
README.md
CHANGELOG.md
LICENSE
*.md
!apps/api/**/*.md

# CI/CD (لا حاجة لها داخل الصورة)
.github/

# تطبيق الويب فقط (نبني API فقط)
apps/web/

# Docker (تجنب تضمين مجلد docker في السياق)
docker/

# محلي
.cache/
tmp/
temp/
uploads/
