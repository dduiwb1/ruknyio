# ================================================================
# Docker Database Configuration
# ================================================================
# ⚠️ IMPORTANT: Generate strong passwords before using in production!
# Generate password: openssl rand -base64 32

# Database Credentials (Change these!)
DB_USER=rukny_admin
DB_PASSWORD=CHANGE_ME_GENERATE_STRONG_PASSWORD
DB_NAME=rukny_io

# ================================================================
# Instructions:
# ================================================================
# 1. Copy this file to .env in the root directory
# 2. Generate a strong password:
#    - Windows PowerShell: 
#      -join ((48..57) + (65..90) + (97..122) | Get-Random -Count 32 | ForEach-Object {[char]$_})
#    - Linux/Mac: 
#      openssl rand -base64 32
# 3. Replace DB_PASSWORD with the generated password
# 4. Update DATABASE_URL in apps/api/.env to match
# ================================================================
