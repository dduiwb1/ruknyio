{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node -e \"try{require('fs').rmSync('node_modules/@types/mapbox__point-geometry',{recursive:true,force:true})}catch{}; try{require('fs').rmSync('../node_modules/@types/mapbox__point-geometry',{recursive:true,force:true})}catch{}; try{require('fs').rmSync('../../node_modules/@types/mapbox__point-geometry',{recursive:true,force:true})}catch{}; const f='public/sw.js',c=require('fs').readFileSync(f,'utf8');require('fs').writeFileSync(f,c.replace('__SW_VERSION__',Date.now().toString()))\" && next build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "lint": "eslint",
    "analyze": "cross-env ANALYZE=true next build --webpack",
    "analyze:server": "cross-env BUNDLE_ANALYZE=server next build --webpack",
    "analyze:browser": "cross-env BUNDLE_ANALYZE=browser next build --webpack"
  },
