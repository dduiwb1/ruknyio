# ============================================
# PRODUCTION ENVIRONMENT VARIABLES
# Railway Configuration for API Deployment
# ============================================
# 
# IMPORTANT: Set these values in your Railway project dashboard
# Do NOT commit sensitive values to version control
# Use Railway's environment variable management for secrets
#

# ============================================
# 🗄️ DATABASE CONFIGURATION
# ============================================
# Railway provides a PostgreSQL database service
# Use Railway's connection string or configure your Neon PostgreSQL
# Format: postgresql://user:password@host:port/database?sslmode=require&connection_limit=10&pool_timeout=20
DATABASE_URL=""

# ============================================
# 🔴 REDIS CONFIGURATION
# ============================================
# Railway provides a Redis service or use upstash
# Format: redis://:password@host:port or using REDIS_URL
REDIS_URL=""
REDIS_HOST=""
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0

# ============================================
# 🌐 APPLICATION CONFIGURATION
# ============================================
NODE_ENV="production"
PORT=3001
HOST="0.0.0.0"

# Production frontend URL
FRONTEND_URL="https://your-production-domain.com"

# Cookie Configuration (HTTPS only in production)
COOKIE_DOMAIN="your-production-domain.com"
COOKIE_SECURE=true

# ============================================
# 🔐 SECURITY & AUTHENTICATION
# ============================================
# Generate secure keys with: openssl rand -hex 32
JWT_SECRET=""
JWT_EXPIRATION="7d"

# Two-Factor Authentication key
TWO_FACTOR_ENCRYPTION_KEY=""

# Internal API Secret
INTERNAL_API_SECRET=""

# ============================================
# 🔑 OAUTH - GOOGLE
# ============================================
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="https://your-production-domain.com/api/v1/auth/google/callback"

# ============================================
# 🔑 OAUTH - LINKEDIN
# ============================================
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_CALLBACK_URL="https://your-production-domain.com/api/v1/auth/linkedin/callback"
LINKEDIN_SCOPES="openid,profile,email"

# ============================================
# 📅 GOOGLE CALENDAR API
# ============================================
GOOGLE_CALENDAR_CLIENT_ID=""
GOOGLE_CALENDAR_CLIENT_SECRET=""
GOOGLE_CALENDAR_REDIRECT_URI="https://your-production-domain.com/api/v1/google/calendar/callback"

# ============================================
# 📊 GOOGLE SHEETS API
# ============================================
GOOGLE_SHEETS_REDIRECT_URI="https://your-production-domain.com/api/v1/integrations/google-sheets/callback"

# ============================================
# 📧 EMAIL CONFIGURATION
# ============================================
# Using Resend (recommended) or SMTP
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Rukny <notifications@rukny.store>"

# Legacy SMTP (optional)
# MAIL_HOST=""
# MAIL_PORT=587
# MAIL_SECURE=false
# MAIL_USER=""
# MAIL_PASSWORD=""
# SMTP_FROM_EMAIL="notifications@yourdomain.com"
# SMTP_FROM_NAME="Rukny"

# ============================================
# 🔒 ACCOUNT LOCKOUT
# ============================================
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
LOCKOUT_MAX_DURATION_MINUTES=1440
LOCKOUT_WINDOW_MINUTES=30
LOCKOUT_PROGRESSIVE_MULTIPLIER=2

# ============================================
# ☁️ AWS S3 CONFIGURATION
# ============================================
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
S3_BUCKET=""
S3_UPLOAD_MAX_MB=5
S3_UPLOAD_MAX_FILES=3
S3_PRODUCT_IMAGE_MAX_SIZE=5242880
S3_PRODUCT_IMAGE_MAX_COUNT=5

# ============================================
# 📱 TELEGRAM BOT (OPTIONAL)
# ============================================
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_NAME="RuknyBot"
TELEGRAM_WEBHOOK_URL=""
TELEGRAM_CHAT_ID=""
TELEGRAM_ENABLED=false

# ============================================
# 📲 WHATSAPP API (OPTIONAL)
# ============================================
WHATSAPP_API_URL=""
WHATSAPP_SESSION_ID=""
WHATSAPP_ACCESS_TOKEN=""

# ============================================
# 📊 MONITORING & LOGGING (OPTIONAL)
# ============================================
# Enable Swagger in production (optional, usually disabled)
ENABLE_SWAGGER=false

# ============================================
# 🎯 RECAPTCHA (OPTIONAL)
# ============================================
RECAPTCHA_SECRET_KEY=""
RECAPTCHA_SITE_KEY=""
RECAPTCHA_ENABLED=false
