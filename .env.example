#=====================================
# RUKNY.IO - Environment Variables
#=====================================

# Node Environment
NODE_ENV=development

#=====================================
# DATABASE CONFIGURATION
#=====================================
DB_NAME=rukny_io
DB_USER=rukny_admin
DB_PASSWORD=change_this_password_in_production
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@localhost:5432/${DB_NAME}

#=====================================
# REDIS CONFIGURATION
#=====================================
REDIS_URL=redis://localhost:6379

#=====================================
# AUTH SERVICE CONFIGURATION
#=====================================
AUTH_SERVICE_PORT=3001
AUTH_SERVICE_URL=http://localhost:3001
AUTH_SERVICE_EXTERNAL_URL=https://auth.rukny.io

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_min_32_chars
JWT_EXPIRATION=7d
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_this_min_32_chars
JWT_REFRESH_EXPIRATION=30d

# Email/SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_or_api_key
SMTP_FROM=noreply@rukny.io
SMTP_FROM_NAME=Rukny

# OAuth Providers (اختياري)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

#=====================================
# API SERVICE CONFIGURATION
#=====================================
API_SERVICE_PORT=3002
API_SERVICE_URL=http://localhost:3002
API_SERVICE_EXTERNAL_URL=https://dev.rukny.io

# Service-to-Service Communication
AUTH_SERVICE_INTERNAL_URL=http://auth:3001

#=====================================
# AWS S3 CONFIGURATION
#=====================================
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=rukny-uploads
AWS_REGION=us-east-1
AWS_S3_URL=https://rukny-uploads.s3.us-east-1.amazonaws.com

# File Upload Configuration
MAX_UPLOAD_SIZE_MB=25
MAX_IMAGE_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/gif
ALLOWED_DOCUMENT_TYPES=application/pdf,application/msword

#=====================================
# WEB APPLICATION CONFIGURATION
#=====================================
NEXT_PUBLIC_API_URL=http://localhost:3002
NEXT_PUBLIC_AUTH_URL=http://localhost:3001
NEXT_PUBLIC_APP_NAME=Rukny
NEXT_PUBLIC_APP_URL=http://localhost:3000

#=====================================
# CORS CONFIGURATION
#=====================================
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,https://rukny.io,https://dev.rukny.io,https://auth.rukny.io,https://dashboard.rukny.io

#=====================================
# SECURITY CONFIGURATION
#=====================================
# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Session Configuration
SESSION_SECRET=your_session_secret_key_min_32_chars
SESSION_MAX_AGE=7200000  # 2 hours in milliseconds
SESSION_SECURE=false     # true in production with HTTPS
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=Lax

# CSRF Protection (if not using SameSite)
CSRF_ENABLED=true

#=====================================
# LOGGING & MONITORING
#=====================================
LOG_LEVEL=debug
SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id

# OpenTelemetry (اختياري)
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

#=====================================
# PAYMENT GATEWAY CONFIGURATION
#=====================================
# Stripe (جزئي حسب الميزات)
STRIPE_PUBLIC_KEY=pk_test_xxxxx
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# PayPal (اختياري)
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_secret

#=====================================
# EMAIL QUEUE CONFIGURATION
#=====================================
BULL_QUEUE_NAME=email-queue
BULL_QUEUE_REDIS_URL=redis://localhost:6379

#=====================================
# FEATURE FLAGS
#=====================================
FEATURE_EMAIL_VERIFICATION=true
FEATURE_OAUTH_LOGIN=true
FEATURE_TWO_FACTOR_AUTH=false
FEATURE_ANALYTICS=true
FEATURE_NOTIFICATIONS=true

#=====================================
# THIRD-PARTY INTEGRATIONS
#=====================================
# Google Analytics
GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X

# Intercom (اختياري)
INTERCOM_APP_ID=your_intercom_app_id

#=====================================
# ADMIN CONFIGURATION
#=====================================
ADMIN_EMAIL=admin@rukny.io
ADMIN_INITIAL_PASSWORD=change_this_on_first_login

#=====================================
# CRON JOBS & SCHEDULED TASKS
#=====================================
# Email cleanup every hour
CLEANUP_SESSIONS_CRON=0 * * * *

# Report generation every midnight
GENERATE_REPORTS_CRON=0 0 * * *

#=====================================
# PRICING & SUBSCRIPTION
#=====================================
DEFAULT_CURRENCY=IQD
SUBSCRIPTION_GRACE_PERIOD_DAYS=14

#=====================================
# PERFORMANCE OPTIMIZATION
#=====================================
CACHE_TTL=300              # 5 minutes
JWT_VERIFICATION_CACHE=300 # Cache JWT verification for 5 minutes
QUERY_PAGINATION_LIMIT=50

#=====================================
# DEVELOPMENT ONLY
#=====================================
# Seed database on startup
SEED_DATABASE=false

# Verbose API logging
API_VERBOSE_LOGGING=false

# GraphQL Playground (if using GraphQL)
GRAPHQL_PLAYGROUND_ENABLED=false

#=====================================
# PRODUCTION OVERRIDES
#=====================================
# Uncomment and update for production:
# NODE_ENV=production
# JWT_SECRET=your_extremely_secret_production_key
# SESSION_SECURE=true
# SENTRY_DSN=https://your_production_sentry_dsn
# NEXT_PUBLIC_API_URL=https://dev.rukny.io
# NEXT_PUBLIC_AUTH_URL=https://auth.rukny.io
# DATABASE_URL=postgresql://prod_user:prod_pass@prod_db_host:5432/rukny_production
